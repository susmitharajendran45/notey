{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TearOffNotepad",
  "version": "1.0.0",
  "identifier": "com.notepad.widget",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "Tear-Off Notepad",
        "width": 640,
        "height": 780,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
    ]
  }
}
