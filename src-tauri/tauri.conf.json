{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "notey",
  "version": "1.0.37",
  "identifier": "com.susmitha.notey",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "notey",
        "width": 360,
        "height": 540,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Susmitha Rajendran",
    "copyright": "Copyright © 2026 Susmitha Rajendran. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Tear-off desktop notepad",
    "longDescription": "A persistent desktop tear-off notepad application created by Susmitha Rajendran.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
