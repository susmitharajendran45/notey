{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TearOffNotepad",
  "version": "1.0.0",
  "identifier": "com.susmitha.tearoffnotepad",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tear-Off Notepad",
        "width": 600,
        "height": 760,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Susmitha Rajendran",
    "copyright": "Copyright © 2026 Susmitha Rajendran. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
